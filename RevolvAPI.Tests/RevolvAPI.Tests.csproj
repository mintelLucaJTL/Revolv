<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Link pure helpers so threshold/progress tests do not rebuild the running API host. -->
  <ItemGroup>
    <Compile Include="..\RevolvAPI\Services\ReturnRateBandRules.cs" Link="ReturnRateBandRules.cs" />
    <Compile Include="..\RevolvAPI\Services\AiRecommendationProgressRules.cs" Link="AiRecommendationProgressRules.cs" />
    <Compile Include="..\RevolvAPI\Services\ToneOfVoiceOptions.cs" Link="ToneOfVoiceOptions.cs" />
    <Compile Include="..\RevolvAPI\Services\AiRecommendationContentRules.cs" Link="AiRecommendationContentRules.cs" />
    <Compile Include="..\RevolvAPI\Services\AiResponseParser.cs" Link="AiResponseParser.cs" />
    <Compile Include="..\RevolvAPI\DTOs\AiResponseDTO.cs" Link="AiResponseDTO.cs" />
  </ItemGroup>

</Project>
